<!-- §17.2 领取礼品:领取只把原权益指向本人,不新建订单;失败按原因分别说,不显示他人订单 -->
<view class="theme-dark gf">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
  <view class="gf__frame" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
    <cy-nav-bar title="{{mode === 'code' ? '兑换码' : '领取礼品'}}" plain custom-back bind:back="goBack" />
    <!-- 缺领取码 / 领取码无效:与其它缺参页同一个「链接已失效 · 返回」 -->
    <cy-empty wx:if="{{state === 'missing'}}" fill="{{true}}" size="lg" kind="missing-param" cta="返回" bind:cta="goBack" />
    <!-- r2-join:领取态用礼物图标(不再用通用空态插画/警告三角),整块居中 -->
    <view wx:else class="gf-hero {{state === 'failed' ? 'is-off' : ''}} {{state === 'claimed' ? 'is-done' : ''}} {{codeErr ? 'is-off' : ''}} {{gfIn === 1 ? 'gf--pre' : ''}} {{gfGlow === 0 ? 'gf-glow--0' : ''}}" aria-role="status">
      <view class="gf-hero__badge">
        <view class="gf-hero__glow" wx:if="{{mode !== 'code' && (state === 'ready' || state === 'unknown')}}"></view>
        <cy-icon name="{{state === 'claimed' ? 'check' : 'gift'}}" size="72" />
      </view>
      <text class="gf-hero__title" wx:if="{{mode === 'code'}}">{{codeTitle}}</text>
      <text class="gf-hero__title" wx:else>{{state === 'claimed' ? '已领取' : state === 'failed' ? reason : '好友送你一份通行证'}}</text>
    </view>
    <view class="gf__bar" wx:if="{{state === 'failed'}}">
      <cy-btn variant="secondary" bindtap="goBack">返回</cy-btn>
    </view>
    <view class="gf__bar" wx:elif="{{state === 'ready' || state === 'claimed' || state === 'unknown'}}">
      <view class="gf__note" wx:if="{{state === 'unknown'}}">还在确认结果，再点一次看看</view>
      <input wx:if="{{mode === 'code' && codeOn && state !== 'claimed'}}" class="gf__input" value="{{code}}" placeholder="输入兑换码" maxlength="64" confirm-type="done" bindinput="onCodeInput" bindconfirm="redeemCode" aria-label="兑换码" />
      <cy-btn wx:if="{{state !== 'claimed' && (mode !== 'code' || codeOn)}}" variant="primary" loading="{{claiming}}" disabled="{{claiming || (mode === 'code' && !code)}}" bindtap="claim">{{mode === 'code' ? '兑换' : '领取'}}</cy-btn>
      <cy-btn wx:elif="{{state === 'claimed'}}" variant="primary" bindtap="goOrder">{{mode === 'code' ? '去玩' : '查看'}}</cy-btn>
      <cy-btn wx:else variant="secondary" bindtap="goBack">返回</cy-btn>
    </view>
  </view>
</view>
