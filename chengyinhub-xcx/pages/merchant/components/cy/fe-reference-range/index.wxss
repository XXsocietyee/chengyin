:host { display: block; }
.fe-range { display: flex; align-items: center; flex-wrap: wrap; gap: var(--cy-space-2); margin-top: var(--cy-space-3); }
.fe-range-date { flex: none; }
.fe-range-btn { flex: none; margin: 0; padding: 0 var(--cy-space-3); min-height: var(--cy-btn-h-sm); line-height: var(--cy-btn-h-sm); border-radius: var(--cy-radius-pill); background: var(--cy-bg-card); color: var(--cy-text-title); font-size: var(--cy-font-caption); font-variant-numeric: tabular-nums; border: 2rpx solid var(--cy-border-card); }
.fe-range-btn::after { border: none; }
.fe-range-export { margin-left: auto; }
.fe-range-link { min-height: var(--cy-btn-h-sm); line-height: var(--cy-btn-h-sm); color: var(--cy-text-secondary); font-size: var(--cy-font-caption); }

/* 按压反馈:组件样式隔离取不到全局 .cy-pressed,与 cy-card 同值 */
.cy-pressed { opacity: .92; transform: scale(.97); }
