:host { display: block; }
.cdready__title {
  display: block;
  margin-bottom: 20rpx;
  color: var(--cy-color-text-primary);
  font-size: var(--cy-font-page-title);
  font-weight: 700;
}
.cdready__section { margin-bottom: 20rpx; }
.cdready__section-title {
  display: block;
  margin-bottom: 16rpx;
  color: var(--cy-color-text-primary);
  font-size: var(--cy-font-subtitle);
  font-weight: 700;
}
.cdready__section-sub {
  display: block;
  margin-bottom: 20rpx;
  color: var(--cy-color-text-tertiary);
  font-size: var(--cy-font-caption);
}
.cdready__caption {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  color: var(--cy-color-text-tertiary);
  font-size: var(--cy-font-caption);
}
.cdready__caption--warning { color: var(--cy-color-status-warning); }
