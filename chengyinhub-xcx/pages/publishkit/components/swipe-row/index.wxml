<wxs module="sw" src="./swipe-row.wxs" />
<view class="sw {{hr ? 'sw--hr' : ''}} {{open ? 'is-open' : ''}} {{editing ? 'is-editing' : ''}} {{_dragging ? 'is-drag' : ''}}">
  <view class="sw__del" bindtap="onDelete" aria-role="button" aria-label="{{deleteText}}{{label}}" aria-hidden="{{!open}}" hover-class="cy-pressed" hover-stay-time="80">{{deleteText}}</view>
  <view class="sw__row" data-open="{{open}}" data-editing="{{editing}}" data-disabled="{{disabled}}" openpx="{{_openPx}}" change:openpx="{{sw.setOpenPx}}"
        bindtouchstart="{{sw.start}}" bindtouchmove="{{sw.move}}" bindtouchend="{{sw.end}}" bindtouchcancel="{{sw.end}}">
    <view wx:if="{{editing}}" class="sw__minus" catchtap="onMinus" aria-role="button" aria-label="删除{{label}}" hover-class="cy-pressed" hover-stay-time="80"></view>
    <view class="sw__main"><slot></slot></view>
    <view wx:if="{{editing}}" class="sw__grip" data-disabled="{{disabled}}" catchtouchstart="{{sw.gripStart}}" catchtouchmove="{{sw.gripMove}}" catchtouchend="{{sw.gripEnd}}" catchtouchcancel="{{sw.gripEnd}}" aria-label="拖动排序{{label}}"></view>
  </view>
  <slot name="xp"></slot>
</view>
